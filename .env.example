# bio-claim-check configuration template.
# Copy to `.env` (git-ignored) and fill in locally. NEVER commit real endpoints or keys.
# Every key is prefixed BCC_; nested settings use a double underscore.

# Required. Sent to Europe PMC in the User-Agent, per their usage etiquette.
BCC_CONTACT_EMAIL=you@example.org

# read-write (default) | read-only (replay from cache, fail closed on a miss) | off
BCC_CACHE_MODE=read-write

# The single writable root for cache, ledger and runs.
BCC_VAR_DIR=var

# DEBUG | INFO | WARNING | ERROR
BCC_LOG_LEVEL=INFO

# --- LLM providers: configure at least one unless BCC_CACHE_MODE=read-only ---

# Azure AI Foundry (resource endpoint + key)
# BCC_FOUNDRY__BASE_URL=https://<your-resource>.services.ai.azure.com
# BCC_FOUNDRY__API_KEY=

# Anthropic API
# BCC_ANTHROPIC__API_KEY=

# Ollama (local open-weight models)
# BCC_OLLAMA__BASE_URL=http://localhost:11434

# --- Role bindings (deployment names) ---
BCC_ANSWER_MODEL=gpt-6.1-sol
BCC_VERIFIER_MODEL=claude-opus-4-8
BCC_TRAP_MODEL=Kimi-K2.6-1
