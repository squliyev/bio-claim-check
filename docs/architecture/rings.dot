digraph {
    node [fontname=helvetica]
    ".app" [label=".app/"]
    ".common" [label=".common/"]
    ".engine" [label=".engine/"]
    ".features" [label=".features/"]
    ".infrastructure" [label=".infrastructure/"]
    ".app" ->  ".common"
    ".app" ->  ".engine"
    ".app" ->  ".features"
    ".app" ->  ".infrastructure"
    ".features" ->  ".common"
    ".features" ->  ".engine"
}
